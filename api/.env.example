# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/leadflow_crm

# Generate both secrets — the API refuses to boot on anything shorter than 24 chars:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-generated-secret
JWT_EXPIRES_IN=12h

# The shared secret the WordPress plugin sends as X-LeadFlow-Token.
# Paste the same value into Settings -> LeadFlow in wp-admin.
WP_SYNC_TOKEN=replace-me-with-a-generated-secret

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# A lead arriving twice within this many days counts as a duplicate.
DUPLICATE_WINDOW_DAYS=30

# The admin account created by `npm run seed`.
ADMIN_NAME=CRM Admin
ADMIN_EMAIL=admin@leadflow.test
ADMIN_PASSWORD=change-this-password
